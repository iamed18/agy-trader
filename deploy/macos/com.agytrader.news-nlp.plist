<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AGY_CONFIG_DIR</key>
		<string>/path/to/agy-trader/config</string>
		<key>AGY_DATA_DIR</key>
		<string>/path/to/agy-trader/data</string>
		<key>HOME</key>
		<string>/Users/<user></string>
		<key>PATH</key>
		<string>/path/to/agy-trader/.venv/bin:/Users/<user>/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>GroupName</key>
	<string>staff</string>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.agytrader.news-nlp</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/agy-trader/.venv/bin/agy-ops</string>
		<string>daemon</string>
		<string>news-nlp</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>UserName</key>
	<string>trader</string>
	<key>WorkingDirectory</key>
	<string>/path/to/agy-trader</string>
</dict>
</plist>
